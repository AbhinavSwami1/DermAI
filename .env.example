# Docker Compose (copy to .env and replace the placeholders; never commit .env)
POSTGRES_DB=dermai
POSTGRES_USER=dermai
POSTGRES_PASSWORD=replace_with_a_strong_password
JWT_SECRET_KEY=replace_with_a_long_random_string

# Local development (npm run dev) only; Compose sets its own value
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
